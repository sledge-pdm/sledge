{
  "name": "sledge",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "dev": "tauri dev",
    "build": "tauri build",
    "wasm:build": "cd wasm && pnpm --ignore-workspace i && wasm-pack build --target bundler && rm pkg/.gitignore && rm pkg/package.json",
    "tsc": "pnpm exec tsc --noEmit --skipLibCheck",
    "bench": "vitest bench -c vitest-bench.config.ts",
    "test": "vitest run -c vitest.config.ts",
    "prettier": "prettier --write . --config .prettierrc",
    "lint": "eslint .",
    "cargo:format": "cd wasm && cargo fmt && cd ../src-tauri && cargo fmt",
    "format": "pnpm prettier && pnpm cargo:format",
    "lint-staged": "lint-staged",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.10",
    "@jaames/iro": "^5.5.2",
    "@jsquash/webp": "^1.5.0",
    "@sledge-pdm/core": "^1.2.5",
    "@sledge-pdm/frasco": "^0.2.4",
    "@sledge-pdm/ui": "^1.2.7",
    "@solid-primitives/deep": "^0.3.5",
    "@solid-primitives/map": "^0.7.3",
    "@solid-primitives/raf": "^2.3.4",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solid-primitives/scroll": "^2.1.5",
    "@solid-primitives/timer": "^1.4.4",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.16.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "base64-arraybuffer": "^1.0.2",
    "interactjs": "^1.10.27",
    "mitt": "^3.0.1",
    "msgpackr": "^1.11.9",
    "solid-js": "^1.9.12",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@acab/ecsstatic": "^0.9.0",
    "@interactjs/types": "^1.10.27",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/browser-playwright": "4.1.4",
    "dotenv": "^17.4.1",
    "eslint": "^10.2.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-glsl": "^1.6.0",
    "vite-plugin-solid": "^2.11.12",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,scss,html,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  }
}
