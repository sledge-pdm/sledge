{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "jsxImportSource": "solid-js",
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@sledge/wasm": ["wasm/pkg/sledge_wasm.js"]
    },
    "types": ["vite/client"],
    "rootDirs": ["src"]
  },
  "exclude": [
    "src-tauri/target",
    "**/out/tauri-codegen-assets/**"
  ]
}
